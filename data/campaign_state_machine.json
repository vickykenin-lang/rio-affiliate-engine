{
  "schema_version": 1,
  "initial_state": "CANDIDATE_REVIEW",
  "terminal_states": ["INSTAGRAM_POSTED", "PUBLISH_FAILED", "REJECTED"],
  "founder_only_actions": [
    "APPROVE_FOR_CREATIVE",
    "APPROVE_TO_PUBLISH",
    "REQUEST_CANDIDATE_CHANGES",
    "REQUEST_CREATIVE_CHANGES",
    "REJECT_CAMPAIGN",
    "PAUSE_CAMPAIGN"
  ],
  "transitions": {
    "CANDIDATE_REVIEW": {
      "APPROVE_FOR_CREATIVE": "APPROVED_FOR_CREATIVE",
      "REQUEST_CANDIDATE_CHANGES": "CANDIDATE_CHANGES_REQUESTED",
      "REJECT_CAMPAIGN": "REJECTED",
      "PAUSE_CAMPAIGN": "PAUSED"
    },
    "CANDIDATE_CHANGES_REQUESTED": {
      "RESUBMIT_CANDIDATE": "CANDIDATE_REVIEW",
      "REJECT_CAMPAIGN": "REJECTED",
      "PAUSE_CAMPAIGN": "PAUSED"
    },
    "APPROVED_FOR_CREATIVE": {
      "START_CREATIVE_GENERATION": "CREATIVE_GENERATING",
      "REJECT_CAMPAIGN": "REJECTED",
      "PAUSE_CAMPAIGN": "PAUSED"
    },
    "CREATIVE_GENERATING": {
      "CREATIVE_GENERATION_SUCCEEDED": "CREATIVE_REVIEW",
      "CREATIVE_GENERATION_FAILED": "CREATIVE_GENERATION_FAILED",
      "PAUSE_CAMPAIGN": "PAUSED"
    },
    "CREATIVE_GENERATION_FAILED": {
      "RETRY_CREATIVE_GENERATION": "CREATIVE_GENERATING",
      "REJECT_CAMPAIGN": "REJECTED",
      "PAUSE_CAMPAIGN": "PAUSED"
    },
    "CREATIVE_REVIEW": {
      "APPROVE_TO_PUBLISH": "APPROVED_TO_PUBLISH",
      "REQUEST_CREATIVE_CHANGES": "CREATIVE_CHANGES_REQUESTED",
      "REJECT_CAMPAIGN": "REJECTED",
      "PAUSE_CAMPAIGN": "PAUSED"
    },
    "CREATIVE_CHANGES_REQUESTED": {
      "START_CREATIVE_CORRECTION": "CREATIVE_GENERATING",
      "REJECT_CAMPAIGN": "REJECTED",
      "PAUSE_CAMPAIGN": "PAUSED"
    },
    "APPROVED_TO_PUBLISH": {
      "START_PUBLISH_PRECHECK": "PUBLISH_PRECHECK",
      "REQUEST_CREATIVE_CHANGES": "CREATIVE_CHANGES_REQUESTED",
      "REJECT_CAMPAIGN": "REJECTED",
      "PAUSE_CAMPAIGN": "PAUSED"
    },
    "PUBLISH_PRECHECK": {
      "PUBLISH_PRECHECK_PASSED": "POST_PENDING",
      "PUBLISH_PRECHECK_BLOCKED": "PUBLISH_BLOCKED",
      "PAUSE_CAMPAIGN": "PAUSED"
    },
    "PUBLISH_BLOCKED": {
      "RETRY_PUBLISH_PRECHECK": "PUBLISH_PRECHECK",
      "REQUEST_CREATIVE_CHANGES": "CREATIVE_CHANGES_REQUESTED",
      "REJECT_CAMPAIGN": "REJECTED",
      "PAUSE_CAMPAIGN": "PAUSED"
    },
    "POST_PENDING": {
      "PUBLISH_SUCCEEDED": "INSTAGRAM_POSTED",
      "PUBLISH_RETRYABLE_FAILED": "PUBLISH_RETRY_WAIT",
      "PUBLISH_NONRETRYABLE_FAILED": "PUBLISH_FAILED"
    },
    "PUBLISH_RETRY_WAIT": {
      "RETRY_PUBLISH": "PUBLISH_PRECHECK",
      "REJECT_CAMPAIGN": "REJECTED",
      "PAUSE_CAMPAIGN": "PAUSED"
    },
    "PAUSED": {
      "RESUME_CAMPAIGN": "$PREVIOUS_STATE",
      "REJECT_CAMPAIGN": "REJECTED"
    },
    "FOUNDER_ACTION_REQUIRED": {
      "RESOLVE_FOUNDER_ACTION": "$PREVIOUS_STATE",
      "REJECT_CAMPAIGN": "REJECTED"
    },
    "INSTAGRAM_POSTED": {},
    "PUBLISH_FAILED": {},
    "REJECTED": {}
  }
}
